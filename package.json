{
  "name": "agent-team-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal managed sandbox project for Agent Team registration and CI probes.",
  "type": "module",
  "bin": {
    "agent-team-sandbox": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "screenshot": "node dist/scripts/screenshot.js",
    "start": "node dist/cli.js status",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
